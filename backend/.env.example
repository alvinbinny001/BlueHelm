# Local development
DATABASE_URL=sqlite:///./neuronex.db

# MySQL example for client accounts and production data
# DATABASE_URL=mysql+pymysql://neuronex_user:change_me@127.0.0.1:3306/neuronex

# Server-side AI Copilot configuration
AI_PROVIDER=demo
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=replace_with_server_only_secret

# Encrypts AI keys saved from the app settings page. Use a long random value in production.
AI_CONFIG_ENCRYPTION_KEY=replace_with_long_random_secret